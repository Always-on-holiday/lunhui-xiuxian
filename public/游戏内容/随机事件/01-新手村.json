            "success": { "text": "虫群被逐出田垄，灵谷重新挺起了叶片。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 3 }] },
            "criticalSuccess": { "text": "你找到虫巢并一次清净，老农把剩下的驱虫香全送给了你。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 4 }, { "type": "item", "operation": "add", "id": "repellent_incense", "quantity": 1 }] }
          }
        },
