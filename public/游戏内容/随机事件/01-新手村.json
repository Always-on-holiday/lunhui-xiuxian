  "randomEvents": [
    {
      "id": "village_herb_001",
      "title": "药婆缺草",
      "levelRange": [1, 3],
      "weight": 12,
      "scope": "player",
      "repeatPolicy": "once_per_life",
      "tags": ["采集", "村民"],
      "intro": "药婆的药篓空了一角。她说山坡上少了一味带银边的草，愿用两块灵石换你跑一趟。",
      "choices": [
        {
          "id": "search_by_leaf",
          "text": "按叶脉和气味寻找",
          "risk": { "grade": "low", "primaryStat": "intelligence", "failureHint": "可能误采毒草并损失气血" },
          "resolution": { "mode": "check", "stat": "intelligence", "difficulty": 10, "contextId": "event_herb_search" },
          "outcomes": {
            "criticalFailure": { "text": "你把刺藤当成了药草，手掌肿得像馒头。", "effects": [{ "type": "health", "operation": "add", "value": -5 }] },
            "failure": { "text": "忙到天黑也只认出几株凡草。药婆仍给了你一点辛苦钱。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 1 }] },
            "success": { "text": "银边在暮色里一闪。你带回了足够的药草。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 2 }, { "type": "item", "operation": "add", "id": "wild_herb", "quantity": 1 }] },
            "criticalSuccess": { "text": "你不仅找到了银边草，还辨出了一株被遮住的伴生药。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 3 }, { "type": "item", "operation": "add", "id": "wild_herb", "quantity": 2 }, { "type": "stat", "operation": "add", "stat": "intelligence", "value": 1 }] }
          }
        },
        {
          "id": "decline",
          "text": "今日另有安排",
          "risk": { "grade": "none", "primaryStat": null, "failureHint": "不会获得报酬" },
          "resolution": { "mode": "fixed" },
          "outcome": { "text": "药婆摆摆手，自己背起了药篓。", "effects": [] }
        }
      ]
    },
    {
      "id": "village_smith_002",
      "title": "铁匠试锤",
      "levelRange": [1, 4],
      "weight": 11,
      "scope": "player",
      "repeatPolicy": "once_per_life",
      "tags": ["锻体", "村民"],
      "intro": "铁匠把一柄小锤丢到你脚边：锻体不是比谁喊得响，先把这块废铁打直。",
      "choices": [
        {
          "id": "steady_hammer",
          "text": "稳住下盘，一锤一锤地敲",
          "risk": { "grade": "low", "primaryStat": "attack", "failureHint": "脱力会损失气血" },
          "resolution": { "mode": "check", "stat": "attack", "difficulty": 10, "contextId": "event_smith_hammer" },
          "outcomes": {
            "criticalFailure": { "text": "锤头擦着脚尖砸下，你狼狈地坐进煤灰里。", "effects": [{ "type": "health", "operation": "add", "value": -4 }] },
            "failure": { "text": "废铁依旧歪着，铁匠却肯定了你没有偷懒。", "effects": [{ "type": "stat", "operation": "add", "stat": "proficiency", "value": 1 }] },
            "success": { "text": "火星迸开，废铁终于被你敲得平直。", "effects": [{ "type": "stat", "operation": "add", "stat": "attack", "value": 1 }, { "type": "spiritStones", "operation": "add", "value": 1 }] },
            "criticalSuccess": { "text": "最后一锤落下，铁片发出清越回响。铁匠从抽屉里取出一块旧牌。", "effects": [{ "type": "stat", "operation": "add", "stat": "attack", "value": 1 }, { "type": "item", "operation": "add", "id": "iron_token", "quantity": 1 }] }
          }
        },
        {
          "id": "watch_first",
          "text": "先看铁匠如何落锤",
          "risk": { "grade": "none", "primaryStat": null, "failureHint": "收益较少" },
          "resolution": { "mode": "fixed" },
          "outcome": { "text": "你记住了发力的节奏。", "effects": [{ "type": "stat", "operation": "add", "stat": "proficiency", "value": 1 }] }
        }
      ]
    },
    {
      "id": "village_fortune_003",
      "title": "村口算命摊",
      "levelRange": [1, 4],
      "weight": 9,
      "scope": "player",
      "repeatPolicy": "once_per_life",
      "tags": ["命数", "隐藏天赋"],
      "intro": "一个瞎眼道人拦住你，说只收一块灵石，便能讲出你命里最缺的东西。",
      "choices": [
        {
          "id": "hear_fortune",
          "text": "付钱听他说完",
          "requirements": [{ "type": "spiritStones", "minimum": 1 }],
          "costs": [{ "type": "spiritStones", "operation": "add", "value": -1 }],
          "risk": { "grade": "medium", "primaryStat": "intelligence", "failureHint": "可能只听到一通套话" },
          "resolution": { "mode": "check", "stat": "intelligence", "difficulty": 12, "contextId": "event_fortune_stall" },
          "modifiers": [
            { "when": { "hiddenTalentId": "unfettered_fate" }, "difficultyDelta": -3, "hidden": true }
          ],
          "outcomes": {
            "criticalFailure": { "text": "道人说得天花乱坠，你离开后才发现钱袋还少了一块灵石。", "effects": [{ "type": "spiritStones", "operation": "add", "value": -1 }] },
            "failure": { "text": "所谓批命，不过是几句人人都能套上的吉话。", "effects": [] },
            "success": { "text": "道人点出你近日心境的破绽，你听后若有所悟。", "effects": [{ "type": "stat", "operation": "add", "stat": "intelligence", "value": 1 }] },
            "criticalSuccess": { "text": "道人握住你的手腕，低声说：无系之人，不必向旧因果低头。", "effects": [{ "type": "flag", "operation": "set", "id": "unfettered_fate_revealed", "value": true }, { "type": "stat", "operation": "add", "stat": "intelligence", "value": 1 }] }
          }
        },
        {
          "id": "walk_away",
          "text": "不理会他",
          "risk": { "grade": "none", "primaryStat": null, "failureHint": "不会损失灵石" },
          "resolution": { "mode": "fixed" },
          "outcome": { "text": "道人在身后笑了一声，没有再追。", "effects": [] }
        }
      ]
    },
    {
      "id": "village_fish_004",
      "title": "山溪灵鱼",
      "levelRange": [2, 5],
      "weight": 10,
      "scope": "player",
      "repeatPolicy": "once_per_life",
      "tags": ["山溪", "奇物"],
      "intro": "浅溪里闪过一道青光。那尾鱼跃出水面时，周围的灵气也跟着荡了一下。",
      "choices": [
        {
          "id": "catch_fish",
          "text": "踩着湿石追上去",
          "risk": { "grade": "medium", "primaryStat": "speed", "failureHint": "可能滑倒受伤" },
          "resolution": { "mode": "check", "stat": "speed", "difficulty": 12, "contextId": "event_spirit_fish" },
          "outcomes": {
            "criticalFailure": { "text": "脚下一滑，你顺着溪水滚出老远。", "effects": [{ "type": "health", "operation": "add", "value": -6 }] },
            "failure": { "text": "鱼尾一摆便没了踪影，只留下一片普通鳞片。", "effects": [] },
            "success": { "text": "你没有抓鱼，只在它跃起时接住了一枚自然脱落的青鳞。", "effects": [{ "type": "item", "operation": "add", "id": "spirit_fish_scale", "quantity": 1 }] },
            "criticalSuccess": { "text": "你跟着灵鱼的路线踏过溪石，竟悟出了一套轻盈步法。", "effects": [{ "type": "item", "operation": "add", "id": "spirit_fish_scale", "quantity": 1 }, { "type": "stat", "operation": "add", "stat": "speed", "value": 1 }] }
          }
        },
        {
          "id": "observe_flow",
          "text": "不惊动它，观察水流",
          "risk": { "grade": "none", "primaryStat": null, "failureHint": "不会获得青鳞" },
          "resolution": { "mode": "fixed" },
          "outcome": { "text": "水流绕石而行，你对借力有了朦胧认识。", "effects": [{ "type": "stat", "operation": "add", "stat": "proficiency", "value": 1 }] }
        }
      ]
    },
    {
      "id": "village_pests_005",
      "title": "灵田虫灾",
      "levelRange": [3, 6],
      "weight": 11,
      "scope": "player",
      "repeatPolicy": "once_per_life",
      "tags": ["灵田", "五行"],
