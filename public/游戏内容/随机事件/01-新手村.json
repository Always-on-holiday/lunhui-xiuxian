          "id": "call_others",
          "text": "去村里喊人帮忙",
          "risk": { "grade": "none", "primaryStat": null, "failureHint": "收益较少" },
          "resolution": { "mode": "fixed" },
          "outcome": { "text": "人多之后，总算赶在天黑前保住了一部分灵谷。", "effects": [{ "type": "spiritStones", "operation": "add", "value": 1 }] }
