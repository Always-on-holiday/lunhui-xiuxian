  "personalThreads": [
    {
      "id": "fame",
      "rootCount": 1,
      "title": "盛名之下",
      "entry": "测灵结束后，众人争相邀你入席，只有哑叔把废祠钥匙压在茶碗下。",
      "choiceFocus": "接受资源但欠下人情，或拒绝奉承并提前接触旧契",
      "reward": { "flag": "noticed_mute_keeper", "stat": "intelligence", "value": 1 },
      "commonQuestLead": "你发现哑叔并不在意天灵根，他在确认你是否会被盛名牵着走。"
    },
    {
      "id": "paired_scroll",
      "rootCount": 2,
      "title": "相生旧卷",
      "entry": "藏书阁残卷的两页无法单独阅读，叠在一起却显出一幅井底水纹。",
      "choiceFocus": "公开残卷换取奖励，或私下追查图中的废祠与枯井",
      "reward": { "flag": "decoded_paired_scroll", "stat": "attack", "value": 1 },
      "commonQuestLead": "残卷边缘的缺口与铁匠铺旧牌完全一致。"
    },
    {
      "id": "herb_basket",
      "rootCount": 3,
      "title": "药篓缺角",
      "entry": "药婆的旧篓夹层里藏着一味只生在阴水旁的续魂草。",
      "choiceFocus": "替药婆保守秘密，或追问草药为何会沾着井水气息",
      "reward": { "flag": "found_soul_herb_trace", "stat": "proficiency", "value": 1 },
      "commonQuestLead": "若曾取得带露野药，药婆会直接承认沈砚来过村中。"
    },
    {
      "id": "courtyard_chores",
      "rootCount": 4,
      "title": "四时杂役",
      "entry": "四座偏院的杂役看似无关，完成后地面水沟却恰好拼成一幅阵图。",
      "choiceFocus": "按规矩交差，或借四象天赋逆着水沟寻找阵眼",
      "reward": { "flag": "mapped_four_courtyards", "stat": "speed", "value": 1 },
      "commonQuestLead": "阵眼指向已经封闭多年的废祠后墙。"
    },
    {
      "id": "five_element_stone",
      "rootCount": 5,
      "title": "井边的五行石",
      "entry": "嘲笑声散去后，井沿五块凡石依次回应你的五道灵气。",
      "choiceFocus": "取走五行石证明自己，或让石头保持原位继续封住井下之物",
      "reward": { "flag": "heard_well_heartbeat", "stat": "defense", "value": 1 },
      "commonQuestLead": "你比其他路线更早听见井底并非水声，而是某种缓慢的心跳。"
    }
  ],
