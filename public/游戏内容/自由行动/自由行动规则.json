{
  "meta": {
    "version": 1,
    "title": "自由行动规则",
    "status": "完整判定算法已接入背包物品、多人房间人物与事件 NPC",
    "design": "通用动作 + 对象标签 + 特殊覆写 + 世界后果"
  },
  "interface": {
    "recommendedActionLimit": 4,
    "extraActionsLabel": "更多行动",
    "alwaysUseAttemptWording": true,
    "showRiskGrade": true,
    "showPrimaryStat": true,
    "showExactFormula": false,
    "confirmLethalAndIrreversibleActions": true
  },
  "algorithm": {
    "version": 1,
    "roll": {
      "minimum": 1,
      "maximum": 100,
      "persistAttemptBeforeRoll": true,
      "deterministicFromAttemptId": true,
      "preventRefreshReroll": true
    },
    "chance": {
      "formula": "clamp(actionMin, actionMax, baseChance + (actorCheck - targetCheck) * statPointPercent + levelDifference * levelPercent + relation * relationFactor + stateModifier + tagModifier + environmentModifier + abilityBonus + itemBonus + contentModifier + repeatPenalty)",
      "statPointPercent": 4,
      "defaultLevelPercent": 2,
      "levelContributionMinimum": -35,
      "levelContributionMaximum": 35,
      "defaultMinimumChance": 5,
      "defaultMaximumChance": 95,
      "modifierMinimum": -60,
      "modifierMaximum": 60,
      "repeatPenaltyPerAttempt": -10,
      "repeatPenaltyMaximum": -30,
      "witnessPenaltyPerPerson": -3,
      "witnessPenaltyMaximum": -15,
      "witnessSensitiveActions": ["steal", "rob", "kill", "infringe"]
    },
    "outcomes": {
      "criticalSuccessThreshold": "min(successChance, clamp(5, 30, successChance - 50))",
      "successThreshold": "successChance",
      "criticalFailureStart": "clamp(55, 96, successChance + 30)",
      "order": ["criticalSuccess", "success", "failure", "criticalFailure"]
    },
    "preview": {
      "showChanceAsRange": true,
      "baseUncertainty": 20,
      "intelligenceReductionPerPoint": 1,
      "minimumUncertainty": 5,
      "maximumUncertainty": 20,
      "riskByEstimatedChance": [
        { "minimum": 80, "grade": "low" },
        { "minimum": 60, "grade": "medium" },
        { "minimum": 40, "grade": "high" },
        { "minimum": 20, "grade": "extreme" },
        { "minimum": 0, "grade": "extreme" }
      ]
    },
    "realmProtection": {
      "hostileActionLevelGapForWarning": 5,
      "hostileActionLevelGapForNearCertainDeath": 10,
      "hostileActionLevelGapForAbsoluteDeath": 20,
      "nearCertainDeathMaximumChance": 5,
      "absoluteDeathMaximumChance": 0,
      "neverHideLethalWarning": true
    },
    "resourcePenalties": {
      "healthBelow25Percent": -10,
      "spiritBelow25Percent": -10,
      "physicalActions": ["threaten", "steal", "rob", "attack", "kill", "destroy_item", "destroy_target"],
      "spiritualActions": ["observe", "talk", "inspect_item", "use_item", "combine_item", "infringe", "search"]
    },
    "combatHandoff": {
      "actions": ["attack", "rob", "kill"],
      "criticalSuccessInitiativeBonus": 2,
      "successInitiativeBonus": 1,
      "failureInitiativeBonus": 0,
      "criticalFailureInitiativeBonus": -2,
      "killSetsLethalCombat": true,
      "singleCheckCannotKillComparableNpc": true
    },
    "idempotency": {
      "requireAttemptId": true,
      "sameAttemptReturnsSameRoll": true,
      "applyEffectsOnce": true,
      "saveResolutionId": true
    }
  },
